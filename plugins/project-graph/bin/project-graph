#!/bin/sh

set -eu

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

case "$0" in
  /*) adapter_path=$0 ;;
  *) adapter_path=$PWD/$0 ;;
esac
adapter_directory=${adapter_path%/*}
plugin_root=$(CDPATH= cd -- "$adapter_directory/.." && pwd -P)

node_path=$(command -v node) || fail '{"code":"NODE_RUNTIME_MISSING","message":"Project Graph CLI requires Node.js 22.13 or newer on PATH."}'
bootstrap_path=$plugin_root/runtime/bootstrap.mjs

if [ ! -r "$bootstrap_path" ]; then
  fail '{"code":"PAYLOAD_MISSING","message":"Project Graph CLI bootstrap is missing."}'
fi

exec "$node_path" "$bootstrap_path" "$@"
